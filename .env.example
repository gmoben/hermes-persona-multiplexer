# Copy to .env (gitignored) for local spike/testing.
# Generic demo squad — these names are examples only.

# One bot token per persona, referenced by `token_env` in config.yaml:
DISCORD_TOKEN_ALEX=
DISCORD_TOKEN_SAM=
DISCORD_TOKEN_MAX=

# Shared authorization across all personas (the brain is one agent):
DISCORD_PERSONAS_ALLOWED_USERS=

# Optional: default channel for cron / proactive delivery:
DISCORD_PERSONAS_HOME_CHANNEL=
