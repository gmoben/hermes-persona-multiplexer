{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "component": "hermes-persona-multiplexer",
      "extra-files": [
        { "type": "yaml", "path": "plugin.yaml", "jsonpath": "$.version" },
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        {
          "type": "generic",
          "path": "discord_personas/__init__.py"
        }
      ]
    }
  },
  "changelog-path": "CHANGELOG.md",
  "comment": "release-please owns version/tag/GitHub release + version sync via extra-files. git-cliff is the authoritative CHANGELOG writer (regenerated on tag in release.yml). The __init__.py version carries an x-release-please-version annotation for the generic updater."
}
