{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "component": "hermes-persona-multiplexer",
      "extra-files": [
        { "type": "yaml", "path": "plugin.yaml", "jsonpath": "$.version" },
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "generic", "path": "discord_personas/__init__.py" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactors" },
        { "type": "docs", "section": "Documentation" },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true }
      ]
    }
  },
  "changelog-path": "CHANGELOG.md",
  "comment": "release-please owns version, tag, GitHub Release, CHANGELOG.md, and version sync via extra-files. The discord_personas/__init__.py version line carries an x-release-please-version annotation for the generic updater."
}
